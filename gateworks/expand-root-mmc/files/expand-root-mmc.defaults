#!/bin/sh

[ -d /overlay/upper ] || exit 0

log() {
	echo "expand_root_mmc: $@" > /dev/console
}

start() {
	type -p parted > /dev/null || { log "Error: missing parted"; return 0; }
	type -p losetup > /dev/null || { log "Error: missing losetup"; return 0; }
	type -p resize2fs > /dev/null || { log "Error: missing resize2fs"; return 0; }

	log "Starting MMC overlay expansion"

	ROOT_BLK="$(readlink -f /sys/dev/block/"$(awk -e \
		'$9=="/dev/root"{print $3}' /proc/self/mountinfo)")"
	ROOT_DISK="/dev/$(basename "${ROOT_BLK%/*}")"
	ROOT_PART="${ROOT_BLK##*[^0-9]}"
	ROOT_DEV="/dev/${ROOT_BLK##*/}"
	LOOP_DEV="$(awk -e '$5=="/overlay"{print $9}' \
		/proc/self/mountinfo)"
	log "root: dev=$ROOT_DEV disk=$ROOT_DISK part=$ROOT_PART loop=$LOOP_DEV"

	log "Resizing partition $ROOT_PART of $ROOT_DISK to the end of the device..."
	parted -f -s "${ROOT_DISK}" resizepart "${ROOT_PART}" 100%
	partprobe "${ROOT_DISK}" || log "partprobe failed, continuing"
	sleep 2
	if [ -z "$LOOP_DEV" ]; then
		LOOP_DEV="$(losetup -f)"
		losetup "${LOOP_DEV}" "${ROOT_DEV}"
	fi

	log "Resizing filesystem $ROOT_DISK via $LOOP_DEV..."
	losetup -c "$LOOP_DEV"
	resize2fs -f "$LOOP_DEV"

	log "MMC overlay expansion complete"
	exit 0
}

start

# uci-defaults contract: delete yourself
rm -f /etc/uci-defaults/99-expand-root-mmc
exit 0

